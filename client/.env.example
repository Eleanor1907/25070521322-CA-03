# Copy this file to ".env" in the client folder (optional).
# Vite only exposes variables that start with VITE_ to the browser,
# so never put passwords or database strings here.

# Nothing is needed here normally: the app calls /api on its own address.
# During development Vite forwards /api to the backend on port 5000, and
# online the same server sends both the website and the API.
# Only if the API is hosted on a different site, uncomment and set this
# before running "npm run build":
# VITE_API_BASE=https://your-api.example.com/api
