# Copy this file to ".env" in the client folder.
# Vite only exposes variables that start with VITE_ to the browser,
# so never put passwords or database strings here.

# Only used for a production build (npm run build).
# During development the app calls /api and Vite forwards it to the
# backend on port 5000 (see vite.config.js), so you don't need to change this.
VITE_API_URL=http://localhost:5000/api
