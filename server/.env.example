# Copy this file to ".env" (same folder) and fill in real values.
# Never commit the real .env file to Git.

# Port the Express API listens on
PORT=5000

# Local MongoDB (MongoDB Community Server running on your laptop):
MONGODB_URI=mongodb://127.0.0.1:27017/flexi

# MongoDB Atlas (cloud) example - replace <username>, <password> and <cluster>:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/flexi?retryWrites=true&w=majority

# Secret used to sign login tokens. Use a long random string and keep it private.
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Address of the React dev server, allowed by CORS
CLIENT_URL=http://localhost:5173
